{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "es2023"],
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "..",
    "outDir": "node_modules/.cache/route-tests",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": false
  },
  "include": ["lib/**/*.ts"]
}
